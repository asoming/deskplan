{
  "name": "rixu-desktop",
  "productName": "日序",
  "version": "1.0.6",
  "desktopName": "io.rixu.desktop",
  "private": true,
  "description": "日序：今天、本周、四象限与随手记录",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "electron test/desktop-smoke.cjs",
    "package": "node scripts/build.cjs",
    "test:planner": "electron test/planner-desktop.cjs",
    "package:linux": "node scripts/build.cjs --linux deb tar.gz --x64",
    "package:win": "node scripts/build.cjs --win nsis --x64",
    "package:mac": "node scripts/build.cjs --mac dmg zip",
    "test:release": "electron test/release-desktop.cjs",
    "test:package": "node scripts/package-smoke.cjs",
    "test:distribution": "node scripts/verify-distribution.cjs",
    "test:language": "electron test/language-desktop.cjs",
    "postinstall": "node scripts/build-window-layer.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": {
    "name": "asoming"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/asoming/rixu.git"
  },
  "homepage": "https://github.com/asoming/rixu"
}
